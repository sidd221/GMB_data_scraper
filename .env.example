# AI Service Configuration
# Copy this file to '.env' and insert your own API keys:
#
# cp .env.example .env

# Selected AI Provider: 'groq' | 'gemini' | 'openai'
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b

# Groq API Key (Recommended - Free & Ultra Fast: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Optional: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
